@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="2" Color="Color.Primary">
        <MudText Typo="Typo.h6" Class="mr-6">Organisationsmanagement</MudText>
        <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.AccountTree">Org-Übersicht</MudNavLink>
        <MudNavLink Href="/mitarbeiter" Icon="@Icons.Material.Filled.People">Mitarbeiter</MudNavLink>
        <MudNavLink Href="/stellen" Icon="@Icons.Material.Filled.Work">Stellen</MudNavLink>
        <MudNavLink Href="/vertretungsregeln" Icon="@Icons.Material.Filled.SwapHoriz">Vertretungsregeln</MudNavLink>
        <MudNavLink Href="/kostenstellen" Icon="@Icons.Material.Filled.AccountBalance">Kostenstellen</MudNavLink>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                       Href="http://localhost:8080/swagger-ui.html"
                       Target="_blank"
                       Color="Color.Inherit"
                       Title="API-Docs" />
    </MudAppBar>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>
